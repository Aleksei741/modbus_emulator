{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Toolchains: Build Everything",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/toolchains/build_windows_toolchain.ps1",
            "args": [
                "-ProjectRoot", "${workspaceFolder}",
                "-ProjectName", "${workspaceFolderBasename}",
                "-BuildDir", "${config:toolchains.buildDir}",
                "-ProxyUrl", "${config:toolchains.proxy.windows}"
            ],
            "presentation": {
                "hidden": false,
                "group": "[1] TOOLCHAINS",
                "order": 1
            }
        },
        {
            "name": "Toolchains: Windows x64 Setup MSYS2 UCRT64",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/toolchains/toolchains/windows-ucrt64/setup_windows_ucrt64.ps1",
            "args": [
                "-ProjectRoot", "${workspaceFolder}",
                "-ProjectName", "${workspaceFolderBasename}",
                "-BuildDir", "${config:toolchains.buildDir}",
                "-ProxyUrl", "${config:toolchains.proxy.windows}"
            ],
            "presentation": {
                "hidden": false,
                "group": "[1] TOOLCHAINS",
                "order": 2
            }
        },
        {
            "name": "Toolchains: Windows x64 Install UCRT64 Libraries",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/toolchains/library/windows-ucrt64/install_libraries_windows_ucrt64.ps1",
            "args": [
                "-ProjectRoot", "${workspaceFolder}",
                "-ProjectName", "${workspaceFolderBasename}",
                "-BuildDir", "${config:toolchains.buildDir}",
                "-ProxyUrl", "${config:toolchains.proxy.windows}"
            ],
            "presentation": {
                "hidden": false,
                "group": "[1] TOOLCHAINS",
                "order": 3
            }
        },
        {
            "name": "Emulator: Run Windows",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/building/windows-x64/run_emulator.ps1",
            "args": [
                "-ToolchainBuildDir", "${config:toolchains.buildDir}",
                "-BuildOutputDir", "${config:emulator.windowsX64.localBuildDir.debug}",
                "-ExecutableName", "${config:emulator.executableName}"
            ],
            "presentation": {
                "hidden": false,
                "group": "[2] PROJECT BUILDS",
                "order": 0
            }
        },
        {
            "name": "Poller: Run Windows",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/building/windows-x64/run_poller.ps1",
            "args": [
                "-ToolchainBuildDir", "${config:toolchains.buildDir}",
                "-BuildOutputDir", "${config:emulator.windowsX64.localBuildDir.debug}",
                "-ExecutableName", "${config:poller.executableName}"
            ],
            "presentation": {
                "hidden": false,
                "group": "[2] PROJECT BUILDS",
                "order": 0
            }
        },
        {
            "name": "Project: Windows x64 Release Package",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/building/windows-x64/build_emulator.ps1",
            "args": [
                "-ProjectRoot", "${workspaceFolder}",
                "-ProjectName", "${workspaceFolderBasename}",
                "-ToolchainBuildDir", "${config:toolchains.buildDir}",
                "-BuildOutputDir", "${config:emulator.windowsX64.localBuildDir.release}",
                "-PackageOutputDir", "${config:emulator.windowsX64.packageDir}",
                "-BuildType", "Release"
            ],
            "presentation": {
                "hidden": false,
                "group": "[2] PROJECT BUILDS",
                "order": 1
            }
        },
        {
            "name": "Project: Windows x64 Debug Build",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/building/windows-x64/build_emulator.ps1",
            "args": [
                "-ProjectRoot", "${workspaceFolder}",
                "-ProjectName", "${workspaceFolderBasename}",
                "-ToolchainBuildDir", "${config:toolchains.buildDir}",
                "-BuildOutputDir", "${config:emulator.windowsX64.localBuildDir.debug}",
                "-BuildType", "Debug"
            ],
            "presentation": {
                "hidden": false,
                "group": "[2] PROJECT BUILDS",
                "order": 2
            }
        }
    ]
}
